IO_LOC "clk" E2;
IO_LOC "key_s1" H11;
IO_LOC "key_s2" H10;
IO_LOC "i2s_bck" K2;
IO_LOC "i2s_lrck" K1;
IO_LOC "i2s_din" L1;
IO_PORT "clk" IO_TYPE=LVCMOS33;
IO_PORT "key_s1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "key_s2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "i2s_bck" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "i2s_lrck" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "i2s_din" IO_TYPE=LVCMOS33 DRIVE=8;

// HC-05 3.3V UART, crossed TX/RX; TTP229 F6/F7 remain separate.
IO_LOC "hc05_rx" F2; // HC-05 TXD -> J3 pin 16.
IO_LOC "hc05_tx" F1; // J3 pin 15 -> HC-05 RXD.
IO_PORT "hc05_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "hc05_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Keep the unused serial clock at its HIGH idle level in direct mode.
IO_LOC "touch_scl" F6;
IO_PORT "touch_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// TTP229 OUT1..8, 8-key direct mode, active-high, 3.3V.
// OUT1 moves from K1 (now DAC LRCK) to K4, J3 pin 5.
// Pull-downs keep disconnected active-high inputs silent.
IO_LOC "touch_out[0]" K4; // OUT1 -> J3 pin 5.
IO_LOC "touch_out[1]" L2; // OUT2 -> J3 pin 4.
IO_LOC "touch_out[2]" J4; // OUT3 -> J3 pin 6.
IO_LOC "touch_out[3]" G1; // OUT4 -> J3 pin 7.
IO_LOC "touch_out[4]" G2; // OUT5 -> J3 pin 8.
IO_LOC "touch_out[5]" L3; // OUT6 -> J3 pin 9.
IO_LOC "touch_out[6]" L4; // OUT7 -> J3 pin 10.
IO_LOC "touch_out[7]" J2; // OUT8 -> J3 pin 21.
IO_PORT "touch_out[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "touch_out[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "touch_out[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "touch_out[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "touch_out[4]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "touch_out[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "touch_out[6]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "touch_out[7]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;

// On-chip ADC bus0 PAD: IOT56[A]=J8/J3 pin 36, IOT56[B]=K8/J3 pin 35.
// A receives AO after 22k/4.7k attenuation; B connects to GND. ADC limit=1V.
USE_ADC_SRC bus0 IOT56;

// APDS-9960 gesture sensor, J3 pin 23/24. Pull up the open-drain bus to 3.3V.
IO_LOC "scl" H4;
IO_LOC "sda" G4;
IO_PORT "scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// Existing 64x64 HUB75E panel connector; no overlap with I2S or touch pads.
// IR break beams: receiver light=0, blocked=1; 3.3V digital outputs only.
// All eight signals use spare J3 pins; HUB75E wiring stays unchanged.
IO_LOC "ir_beam[0]" L7; // J3 pin 30, C4.
IO_LOC "ir_beam[1]" K7; // J3 pin 28, D4.
IO_LOC "ir_beam[2]" A1; // J3 pin 17, E4.
IO_LOC "ir_beam[3]" D1; // J3 pin 19, F4.
IO_LOC "ir_beam[4]" E3; // J3 pin 20, G4.
IO_LOC "ir_beam[5]" J1; // J3 pin 22, A4.
IO_LOC "ir_beam[6]" H2; // J3 pin 25, B4.
IO_LOC "ir_beam[7]" H1; // J3 pin 26, C5.
IO_PORT "ir_beam[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF;
IO_PORT "ir_beam[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF;
IO_PORT "ir_beam[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF;
IO_PORT "ir_beam[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF;
IO_PORT "ir_beam[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF;
IO_PORT "ir_beam[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF;
IO_PORT "ir_beam[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF;
IO_PORT "ir_beam[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF;

IO_LOC "hub_R1" G10;
IO_LOC "hub_G1" G11;
IO_LOC "hub_B1" D10;
IO_LOC "hub_R2" B10;
IO_LOC "hub_G2" B11;
IO_LOC "hub_B2" C10;
IO_LOC "hub_A" A10;
IO_LOC "hub_B" A11;
IO_LOC "hub_C" E10;
IO_LOC "hub_D" E11;
IO_LOC "hub_E" C11;
IO_LOC "hub_CK" L11;
IO_LOC "hub_ST" K11;
IO_LOC "hub_OE" K5;
IO_PORT "hub_R1" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hub_G1" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hub_B1" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hub_R2" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hub_G2" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hub_B2" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hub_A" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hub_B" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hub_C" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hub_D" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hub_E" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hub_CK" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hub_ST" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hub_OE" IO_TYPE=LVCMOS33 DRIVE=8;
