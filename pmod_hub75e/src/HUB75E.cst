// Dock S2 is active-high. Press toggles 8/16-key software mode.
IO_LOC "S2" H10;
IO_PORT "S2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "CLK_IN" E2;
IO_PORT "CLK_IN" PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

// TTP229-BSF HW-136: TP2 open for 8 keys, shorted for 16 keys.
// TP3+TP4 shorted for multi-key mode; power-cycle after jumper changes.
// Active-low SDO. 40Pin header SDRAM A0/A1, verified 3.3V bank.
IO_LOC "touch_scl" F6;
IO_PORT "touch_scl" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "touch_sdo" F7;
IO_PORT "touch_sdo" PULL_MODE=UP BANK_VCCIO=3.3;

// mode_16=0: OUT1..OUT8 direct inputs, same unused J3 pins as ttp229_gpio.
// No pulls: TTP229 reuses these pins as touch electrodes in 16-key mode.
IO_LOC "touch_out[0]" K1; // OUT1 -> J3 pin 2.
IO_PORT "touch_out[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "touch_out[1]" L2; // OUT2 -> J3 pin 4.
IO_PORT "touch_out[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "touch_out[2]" J4; // OUT3 -> J3 pin 6.
IO_PORT "touch_out[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "touch_out[3]" G1; // OUT4 -> J3 pin 7.
IO_PORT "touch_out[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "touch_out[4]" G2; // OUT5 -> J3 pin 8.
IO_PORT "touch_out[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "touch_out[5]" L3; // OUT6 -> J3 pin 9.
IO_PORT "touch_out[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "touch_out[6]" L4; // OUT7 -> J3 pin 10.
IO_PORT "touch_out[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "touch_out[7]" J2; // OUT8 -> J3 pin 21.
IO_PORT "touch_out[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
