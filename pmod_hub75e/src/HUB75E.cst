IO_PORT "hub_B" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "hub_A" A10;
IO_PORT "hub_A" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
