// Tang Primer 25K / GW5A-LV25MG121NC1/I0. 50 MHz clock, 3.3 V I/O.
IO_LOC "CLK_IN" E2;
IO_PORT "CLK_IN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "touch_scl" F6;
// Dock J3 pin 37 = IOT58B/F6. Remove SDRAM daughterboard, if fitted.
IO_PORT "touch_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "touch_sdo" F7;
// Dock J3 pin 38 = IOT58A/F7.
IO_PORT "touch_sdo" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "led_key" E8;
IO_PORT "led_key" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_run" D7;
IO_PORT "led_run" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// Onboard debugger UART: FPGA C3 -> BL616 RX -> J8 USB-C virtual COM.
IO_LOC "uart_tx" C3;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
