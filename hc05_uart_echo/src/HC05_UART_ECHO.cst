// Tang Primer 25K Dock 60033: TX=J3 pin 15/F1, RX=J3 pin 16/F2.
// F6/F7 remain available for TTP229. F1/F2 are 3.3 V bank 5 GPIO.
IO_LOC "CLK_IN" E2;
IO_PORT "CLK_IN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "hc05_tx" F1;
IO_PORT "hc05_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "hc05_rx" F2;
IO_PORT "hc05_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "led_rx" E8;
IO_PORT "led_rx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_run" D7;
IO_PORT "led_run" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
