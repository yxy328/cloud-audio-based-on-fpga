# Gowin generated outputs; preserve reproducible project process settings.
**/impl/*
!**/impl/*_process_config.json
!**/impl/project_process_config.json
*.gprj.user

# Simulation and Python caches.
**/sim/build/
*.vcd
*.vvp
*.out
__pycache__/
*.py[cod]
.venv/
venv/

# Logs and temporary editor files.
*.log
*.tmp
*.bak
*.swp
*~
Thumbs.db
.DS_Store

# Local credentials (never store API keys in Git).
.env
.env.*
!.env.example
auth.json
*.pem
*.key

# Explicit development review bundle; never a substitute for a release .fs.
/pcm5102_pam8403/录制回放_开发验证/
/pcm5102_pam8403/录制回放_开发验证.zip
/pcm5102_pam8403/独立录放_完整工程/
/pcm5102_pam8403/独立录放_完整工程.zip
/pcm5102_pam8403/android_app/dist/FPGA-Event-Take-preview.apk

# Duplicate generated archives already represented by source projects.
/pcm5102_pam8403.zip
/pcm5102_pam8403*.zip
/ALL_IN.zip
/fpga-musical-magic-box-master.zip
/fpga-musical-magic-box-master/
/xqr/fpga-musical-magic-box-master/
/pcm5102_pam8403/dsh-acl-recovery/
/ALL_IN/pcm5102_pam8403/tools/local_sim/
/ALL_IN/pcm5102_pam8403/tmp/
*.lnk
/pmod_hub75e/HUB75E.fs.7z

# Delivery zips duplicate the same-named directories; source snapshots duplicate the repo itself.
/pcm5102_pam8403/deliveries/*.zip
/pcm5102_pam8403/deliveries/*/*_sources.zip

# Keil build outputs and per-user UI settings for the STM32 reference project.
/1-2-4-按键控制LED程序/*.o
/1-2-4-按键控制LED程序/*.d
/1-2-4-按键控制LED程序/*.crf
/1-2-4-按键控制LED程序/*.lst
/1-2-4-按键控制LED程序/*.axf
/1-2-4-按键控制LED程序/*.hex
/1-2-4-按键控制LED程序/*.map
/1-2-4-按键控制LED程序/*.lnp
/1-2-4-按键控制LED程序/*.dep
/1-2-4-按键控制LED程序/*.plg
/1-2-4-按键控制LED程序/*.tra
/1-2-4-按键控制LED程序/*.htm
/1-2-4-按键控制LED程序/*.uvguix.*
/1-2-4-按键控制LED程序/*.uvopt
/1-2-4-按键控制LED程序/*.uvoptx
/1-2-4-按键控制LED程序/*.saved_uv4

# Per-run audit folders keep their written reports; the copied synthesis/PnR
# snapshot trees and starting-state patches inside them are rebuildable local data.
/pcm5102_pam8403/reports/*/*/
/pcm5102_pam8403/reports/*/*.patch

# Scratch verification APKs built outside dist/ are not release artifacts.
/pcm5102_pam8403/android_app/*.apk
/pcm5102_pam8403/android_app/*.idsig

# Layout renders duplicate the same images inside deliveries/APP_HUE33_20261023/layouts/.
/pcm5102_pam8403/android_app/design/out/hue33/[0-9]*_[0-9]*.png

# Rebuilt bitstream and APK copies plus raw per-sample simulation vectors inside
# audit folders stay local; only written reports and JSON/CSV summaries are versioned.
/pcm5102_pam8403/reports/*/*.fs
/pcm5102_pam8403/reports/*/*.apk
/pcm5102_pam8403/reports/*/*_vectors.txt
/pcm5102_pam8403/reports/*/*_output.csv

# dist/ keeps the rolling entry plus the APKs documented by the release notes;
# superseded per-code appearance builds stay local and remain in git history.
/pcm5102_pam8403/android_app/dist/*.apk

!/pcm5102_pam8403/android_app/dist/FPGA-Music-Unified.apk
!/pcm5102_pam8403/android_app/dist/FPGA-HC05-Audio-Route2.apk
!/pcm5102_pam8403/android_app/dist/FPGA-Music-Pedal.apk
!/pcm5102_pam8403/android_app/dist/FPGA-Music-Chromatic.apk
!/pcm5102_pam8403/android_app/dist/FPGA-Music-LinkDiag-Code24.apk
!/pcm5102_pam8403/android_app/dist/FPGA-Music-Hue33-Code25.apk
!/pcm5102_pam8403/android_app/dist/FPGA-Music-Touch16-Code26.apk
!/pcm5102_pam8403/android_app/dist/FPGA-Music-FX3-Code27.apk
!/pcm5102_pam8403/android_app/dist/FPGA-Music-Performance-Code35.apk
!/pcm5102_pam8403/android_app/dist/FPGA-Music-ScoreBend-Code39.apk

# Manual design backups next to the rendered assets they already replace.
/pcm5102_pam8403/android_app/design/*_backup.png
