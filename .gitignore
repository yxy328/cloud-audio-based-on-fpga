# Gowin generated outputs; preserve reproducible project process settings.
**/impl/*
!**/impl/*_process_config.json
!**/impl/project_process_config.json
*.gprj.user

# Simulation and Python caches.
**/sim/build/
*.vcd
*.vvp
*.out
__pycache__/
*.py[cod]
.venv/
venv/

# Logs and temporary editor files.
*.log
*.tmp
*.bak
*.swp
*~
Thumbs.db
.DS_Store

# Local credentials (never store API keys in Git).
.env
.env.*
!.env.example
auth.json
*.pem
*.key

# Duplicate generated archives already represented by source projects.
/pcm5102_pam8403.zip
/pcm5102_pam8403*.zip
/ALL_IN.zip
/ALL_IN/pcm5102_pam8403/tools/local_sim/
/ALL_IN/pcm5102_pam8403/tmp/
*.lnk
/pmod_hub75e/HUB75E.fs.7z

